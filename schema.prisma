  trips                          Trip[]                    @relation("Trip_advisor")
  insuranceOffers                InsuranceOffer[]          @relation("InsuranceOffer_recordedBy")
  inquiries                      Inquiry[]                 @relation("Inquiry_assignedAdvisor")
  commissionLedger               AdvisorCommissionLedger[] @relation("AdvisorCommissionLedger_advisor")
  auditEvents                    AuditEvent[]              @relation("AuditEvent_actor")
  requestedApprovals             ManagerApproval[]         @relation("ManagerApproval_requestedBy")
  approvedApprovals              ManagerApproval[]         @relation("ManagerApproval_approvedBy")
  processedPayments              Payment[]                 @relation("Payment_processedBy")
  requestedRefunds               Refund[]                  @relation("Refund_requestedBy")
  approvedRefunds                Refund[]                  @relation("Refund_approvedBy")
